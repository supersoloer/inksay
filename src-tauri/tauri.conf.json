{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "InkSay",
  "version": "0.1.0",
  "identifier": "com.supersoloer.inksay.macos",
  "build": {
    "beforeDevCommand": "npm run build:whisper && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build && npm run build:whisper",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "InkSay",
        "visible": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 20,
          "y": 18
        },
        "width": 980,
        "height": 680,
        "minWidth": 900,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; media-src 'self' data:; style-src 'self' 'unsafe-inline'",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "entitlements": "Entitlements.plist"
    },
    "externalBin": [
      "binaries/whisper-server"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/ggml-silero-v6.2.0.bin",
      "resources/SILERO-LICENSE",
      "resources/asr-test.wav",
      "resources/FLACENC-LICENSE",
      "resources/INKSAY-LICENSE",
      "resources/INKSAY-NOTICE",
      "resources/WHISPER-LICENSE",
      "resources/THIRD-PARTY-LICENSES.txt"
    ]
  }
}
